WriteRow call:[setprecision]
TokenizeLine call:[back,begin,clear,empty,erase,find,front,iss,isspace,pop_back,push_back,size] noreturn:[clear,erase,pop_back,push_back]
ColumnsToPoint call:[Point6D,stod] noreturn:[Point6D]
ReadLines call:[getline,isspace,push_back] noreturn:[push_back]
WritePose call:[WriteRow]
ReadPose call:[ColumnsToPoint,ReadLines,TokenizeLine,empty,size] noreturn:[ColumnsToPoint]
WriteKinematics call:[WriteRow] noreturn:[WriteRow]
ReadKinematics call:[ColumnsToPoint,ReadLines,TokenizeLine,any_of,begin,empty,end,has_value,push_back,size] noreturn:[has_value,push_back]
WritePoseFile call:[WritePose,f] noreturn:[WritePose]
ReadPoseFile call:[ReadPose,f] noreturn:[ReadPose]
WriteKinematicsFile call:[WriteKinematics,f] noreturn:[WriteKinematics]
ReadKinematicsFile call:[ReadKinematics,f] noreturn:[ReadKinematics]
