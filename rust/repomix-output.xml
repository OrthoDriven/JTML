use cxx_qt_build::{CxxQtBuilder, QmlModule};

fn main() {
    CxxQtBuilder::new_qml_module(
        QmlModule::new("JTML.Settngs").qml_file("qml/SettingsControl.qml"),
    )
    .qt_module("Qml")
    .files(["src/qml_settings.rs"])
    .build();
}
